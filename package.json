{
  "name": "infinite-liquid-glass-replica",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port 5280 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5280 --strictPort",
    "review": "npm run build && vite preview --host 127.0.0.1 --port 5293 --strictPort",
    "review:lan": "npm run build && vite preview --host 0.0.0.0 --port 5293 --strictPort"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@types/three": "0.185.4"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "three": "0.185.0",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
