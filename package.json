{
  "name": "infinite-liquid-glass-replica",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port 5280 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5280 --strictPort",
    "capture:reference": "node scripts/capture-reference.mjs",
    "capture:local": "node scripts/capture-local.mjs",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test:interaction": "playwright test tests/interaction.spec.ts",
    "test:performance": "playwright test tests/performance.spec.ts",
    "test:responsive": "playwright test tests/responsive.spec.ts",
    "test:infinite-loop": "playwright test tests/infinite-loop.spec.ts",
    "qa": "node scripts/qa.mjs",
    "v4:source": "node scripts/v4/check-source-of-truth.mjs",
    "v4:check": "node --test tests/v4/*.test.mjs",
    "v4:golden:lock": "node scripts/v4/golden-manifest.mjs --create-lock",
    "v4:golden:verify": "node scripts/v4/golden-manifest.mjs --verify --output qa-v4/results/golden-manifest.local.json",
    "v4:extract:frozen": "node -e \"if(!process.env.ILG_GOLDEN_DIR)throw new Error('ILG_GOLDEN_DIR is required')\" && python3 scripts/v4/extract-frozen-visual.py \"$ILG_GOLDEN_DIR/target.mp4\" qa-v4/reference/frozen-visual",
    "v4:serve:controlled-local": "node scripts/v4/serve-controlled-local.mjs",
    "v4:capture:controlled": "node scripts/v4/capture-controlled-reference.mjs",
    "v4:references": "node scripts/v4/reference-status.mjs",
    "v4:schemas": "python3 scripts/v4/validate-reference-schemas.py",
    "v4:capture:optics": "node scripts/v4/capture-optics-lab.mjs",
    "v4:preview:phase1b": "vite preview --host 127.0.0.1 --port 5281 --strictPort",
    "v4:capture:phase1b": "node scripts/v4/capture-optics-lab.mjs '--url=http://127.0.0.1:5281/glass-lab-v4?qa=1'",
    "v4:measure:optics": "python3 scripts/v4/measure-optics-lab.py",
    "v4:measure:phase1b": "python3 scripts/v4/measure-frozen-calibration.py",
    "v4:review:phase1b": "python3 scripts/v4/build-phase1b-review.py",
    "qa:v4:baseline": "node scripts/v4/phase0-baseline.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@types/three": "0.185.4",
    "playwright": "1.59.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "three": "0.185.0",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
