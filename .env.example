# Public browser configuration. Both values are safe to expose to the Vite
# client bundle. Use a modern publishable key (sb_publishable_...), not a
# service-role or secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional operational limits.
VITE_CONTENT_FETCH_TIMEOUT_MS=4500
VITE_MEDIA_MAX_FILE_SIZE_MB=100

# Leave unset in production. When Supabase configuration is absent, the admin
# automatically enters a clearly labelled local sandbox. Setting this to true
# also forces that sandbox during local UI development.
VITE_CONTENT_ADMIN_LOCAL_MODE=false
