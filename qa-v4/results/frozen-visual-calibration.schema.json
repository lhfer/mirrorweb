{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirrorweb.invalid/schemas/v4/frozen-visual-calibration.schema.json",
  "title": "Sanitized Phase 1B Frozen Visual calibration result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "phase",
    "generator",
    "generatedAt",
    "status",
    "sourceIdentity",
    "captureAttestation",
    "evidenceIntegrity",
    "opticalZoneMetrics",
    "targetRelativeMetrics",
    "reflectionShellAB",
    "privateReviewArtifacts",
    "finalTargetMatch",
    "caveats"
  ],
  "properties": {
    "$schema": { "const": "frozen-visual-calibration.schema.json" },
    "schemaVersion": { "const": 1 },
    "phase": { "const": "phase-1b-frozen-visual-calibration" },
    "generator": { "const": "phase1b-frozen-calibration-v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["BLOCKED", "CONDITIONAL"] },
    "sourceIdentity": {
      "oneOf": [
        { "$ref": "#/$defs/capturedSourceIdentity" },
        { "$ref": "#/$defs/unavailableSourceIdentity" }
      ]
    },
    "captureAttestation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "sourceIdentityCheckPassed",
            "sourceIdentityStartDigest",
            "sourceIdentityEndDigest",
            "previewPassed",
            "previewOriginPublished",
            "distTreeSha256",
            "distFileCount",
            "servedResourceManifestSha256",
            "servedResourceCount",
            "runtimeContractPassed",
            "hardwareWebGpu",
            "adapter",
            "pageErrorCount",
            "captureScriptSha256",
            "captureScriptVersion",
            "screenshotSetSha256",
            "sessionVideoSha256",
            "captureCount"
          ],
          "properties": {
            "status": { "const": "PASS" },
            "sourceIdentityCheckPassed": { "const": true },
            "sourceIdentityStartDigest": { "$ref": "#/$defs/sha256" },
            "sourceIdentityEndDigest": { "$ref": "#/$defs/sha256" },
            "previewPassed": { "const": true },
            "previewOriginPublished": { "const": false },
            "distTreeSha256": { "$ref": "#/$defs/sha256" },
            "distFileCount": { "type": "integer", "minimum": 1 },
            "servedResourceManifestSha256": { "$ref": "#/$defs/sha256" },
            "servedResourceCount": { "type": "integer", "minimum": 1 },
            "runtimeContractPassed": { "const": true },
            "hardwareWebGpu": { "const": true },
            "adapter": {
              "type": "object",
              "additionalProperties": false,
              "required": ["vendor", "architecture", "isFallbackAdapter"],
              "properties": {
                "vendor": { "type": ["string", "null"] },
                "architecture": { "type": ["string", "null"] },
                "isFallbackAdapter": { "const": false }
              }
            },
            "pageErrorCount": { "const": 0 },
            "captureScriptSha256": { "$ref": "#/$defs/sha256" },
            "captureScriptVersion": { "const": "optics-lab-capture-phase1b-v2" },
            "screenshotSetSha256": { "$ref": "#/$defs/sha256" },
            "sessionVideoSha256": { "$ref": "#/$defs/sha256" },
            "captureCount": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "const": "BLOCKED" } }
        }
      ]
    },
    "measurementRun": { "type": "object" },
    "evidenceIntegrity": {
      "type": "object",
      "required": ["status"],
      "properties": { "status": { "enum": ["PASS", "BLOCKED"] } }
    },
    "targetTruth": { "type": "object" },
    "roleMapping": { "type": "object" },
    "opticalZoneMetrics": { "type": "object" },
    "normalizedEdgeProfiles": { "type": "object" },
    "localMetrics": { "type": "object" },
    "targetRelativeMetrics": { "$ref": "#/$defs/targetRelativeMetrics" },
    "reflectionShellAB": {
      "type": "object",
      "additionalProperties": false,
      "required": ["additive", "energyControlled", "comparison"],
      "properties": {
        "additive": { "$ref": "#/$defs/metricEvidence" },
        "energyControlled": { "$ref": "#/$defs/metricEvidence" },
        "comparison": { "$ref": "#/$defs/metricEvidence" }
      }
    },
    "privateReviewArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactCount", "artifacts", "pathsPublished", "pixelsPublished"],
      "properties": {
        "artifactCount": { "type": "integer", "minimum": 0 },
        "artifacts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256", "privatePixelArtifact"],
            "properties": {
              "sha256": { "$ref": "#/$defs/sha256" },
              "privatePixelArtifact": { "const": true }
            }
          }
        },
        "pathsPublished": { "const": false },
        "pixelsPublished": { "const": false }
      }
    },
    "finalTargetMatch": { "const": "BLOCKED" },
    "caveats": { "type": "object" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "runtimeFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryRelativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "capturedSourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozenVideoSha256",
        "frozenSanitizedManifestSha256",
        "frozenCanonicalManifestSha256",
        "frozenArtifactSetSha256",
        "frozenPrivateManifestSha256",
        "localCaptureManifestSha256",
        "localHead",
        "localRuntimeSourceSetSha256",
        "localDirtyRepository",
        "localDirtyWithinRuntimeScope",
        "files",
        "calibrationPriorSha256",
        "annotationSetSha256"
      ],
      "properties": {
        "frozenVideoSha256": { "$ref": "#/$defs/sha256" },
        "frozenSanitizedManifestSha256": { "$ref": "#/$defs/sha256" },
        "frozenCanonicalManifestSha256": { "$ref": "#/$defs/sha256" },
        "frozenArtifactSetSha256": { "$ref": "#/$defs/sha256" },
        "frozenPrivateManifestSha256": { "$ref": "#/$defs/sha256" },
        "localCaptureManifestSha256": { "$ref": "#/$defs/sha256" },
        "localHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "localRuntimeSourceSetSha256": { "$ref": "#/$defs/sha256" },
        "localDirtyRepository": { "const": false },
        "localDirtyWithinRuntimeScope": { "const": false },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/runtimeFile" }
        },
        "calibrationPriorSha256": { "$ref": "#/$defs/sha256" },
        "annotationSetSha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "unavailableSourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "files"],
      "properties": {
        "status": { "const": "UNAVAILABLE" },
        "files": { "type": "array", "maxItems": 0 }
      }
    },
    "metricEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value"],
      "properties": {
        "status": { "enum": ["BLOCKED", "CONDITIONAL", "MEASURED"] },
        "value": true,
        "reason": { "type": "string" },
        "evidence": true
      }
    },
    "targetRelativeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rimWidthRelativeError",
        "shoulderWidthRelativeError",
        "highlightWidthRelativeError",
        "highlightPositionRelativeError",
        "centerRimSharpnessRatioError",
        "dispersionWidthRelativeError",
        "brightDarkBackgroundResponseDifference",
        "cornerRefractionSignature",
        "sidewallContentCompression",
        "targetLocalEdgeRoiOverlay"
      ],
      "properties": {
        "rimWidthRelativeError": { "$ref": "#/$defs/metricEvidence" },
        "shoulderWidthRelativeError": { "$ref": "#/$defs/metricEvidence" },
        "highlightWidthRelativeError": { "$ref": "#/$defs/metricEvidence" },
        "highlightPositionRelativeError": { "$ref": "#/$defs/metricEvidence" },
        "centerRimSharpnessRatioError": { "$ref": "#/$defs/metricEvidence" },
        "dispersionWidthRelativeError": { "$ref": "#/$defs/metricEvidence" },
        "brightDarkBackgroundResponseDifference": { "$ref": "#/$defs/metricEvidence" },
        "cornerRefractionSignature": { "$ref": "#/$defs/metricEvidence" },
        "sidewallContentCompression": { "$ref": "#/$defs/metricEvidence" },
        "targetLocalEdgeRoiOverlay": { "$ref": "#/$defs/metricEvidence" }
      }
    }
  }
}
